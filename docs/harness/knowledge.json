  "rules": [
    {"id":"R01","scope":["hanzi","words"],"statement":"汉字和单词普通复习为当日固定批次，最多 20 项；不能套用 IPA 全量策略。","evidence":[{"sourceId":"constants","anchor":"DAILY_REVIEW_LIMIT = 20"},{"sourceId":"hanzi-engine","anchor":".slice(0, DAILY_REVIEW_LIMIT)"}]},
    {"id":"R02","scope":["phonetics"],"statement":"每次进入音标复习包含全部非 mastered 项，0–48；mastered 是唯一排除条件。","evidence":[{"sourceId":"ipa-engine","anchor":"this.words.filter((item) => !this.isMastered(item.id))"},{"sourceId":"policy","anchor":"from 0 to 48"}]},
    {"id":"R03","scope":["pinyin"],"statement":"拼音有 63 项，复用音标策略，每次复习全部非 mastered 项；只写独立拼音 key。","evidence":[{"sourceId":"pinyin-engine","anchor":"extends PhoneticsEngine"},{"sourceId":"pinyin-storage","anchor":"mario-pinyin-v1"},{"sourceId":"policy","anchor":"(0–63)"}]},
    {"id":"R04","scope":["words"],"statement":"单词使用三个源模块的全部内容定义，按英文拼写规范化去重，ID 稳定；直接复用汉字引擎和 3 新/3 次/混合/20 复习规则，不导入源学习状态。","evidence":[{"sourceId":"words-model","anchor":"id: `word:${entry.word}`"},{"sourceId":"words-entry","anchor":"new HanziEngine"},{"sourceId":"constants","anchor":"DAILY_NEW_REQUIRED_CORRECT = 3"}]},
    {"id":"R05","scope":["words"],"statement":"单词中文在左图下始终可见；英文和 IPA 经 Show/Space/Y 揭示，换词或刷新重置隐藏。","evidence":[{"sourceId":"policy","anchor":"Chinese translation always visible below"},{"sourceId":"words-entry","anchor":"function reveal()"}]},
    {"id":"R06","scope":["review","words","scenario","book1","theme"],"statement":"定义目录与已学库不同；总复习只读 Book1、主题、情景三源实际已学记录，规范化拼写去重；单词模块不是第四个已学来源。","evidence":[{"sourceId":"word-library","anchor":"export function totalLearnedWordSources"},{"sourceId":"word-library","anchor":".filter(({ word }) => sources.has(normalizeLibraryWord(word)))"},{"sourceId":"policy","anchor":"overall review aggregation remain untouched"}]},
    {"id":"R07","scope":["global"],"statement":"各模块只写自己的业务 key；不得跨模块重置、迁移、覆写。跨模块聚合保持只读，既有明确迁移例外按各模块实现处理。","evidence":[{"sourceId":"policy","anchor":"Do not let one module reset, migrate, or overwrite another module's key."}]},
    {"id":"R08","scope":["review"],"statement":"总复习仅保存自己的轮次和 remembered/forgotten 标记；刷新续轮，再来一轮才重排，forgotten 优先；记忆标记不修改源记录。","evidence":[{"sourceId":"review-state","anchor":"mario-total-review-v1"},{"sourceId":"review-state","anchor":"forgotten: 0, unmarked: 1, remembered: 2"},{"sourceId":"review-state","anchor":"const saved = restart ? null : this.round"}]},
    {"id":"R09","scope":["scenario","review"],"statement":"情景完成与单词学会分离；新词只属于活动情景，只有显式学会才写 scenario.learnedWords，不写主题 key。","evidence":[{"sourceId":"scenario-words","anchor":"function markLearned(word, learned)"},{"sourceId":"scenario-entry","anchor":"completedScenarioIds"},{"sourceId":"policy","anchor":"dialogue completion is not added"}]},
    {"id":"R10","scope":["scenario"],"statement":"情景练习两步揭示：先 IPA，后英文+IPA；同句朗读保留，换句/阶段/重播/刷新重置；播放由用户发起。","evidence":[{"sourceId":"scenario-entry","anchor":"Math.min(2, dialogueRevealStep + 1)"},{"sourceId":"scenario-entry","anchor":"revealedDialogueId = \"\"; dialogueRevealStep = 0"},{"sourceId":"scenario-playback","anchor":"createDialoguePlayback"}]},
    {"id":"R11","scope":["book1"],"statement":"Book1 仅从旧英文 key 迁移 opw1；不引入 Book2；现有稳定内容和存档 ID 必须保留。","evidence":[{"sourceId":"book-storage","anchor":"mario-literacy-english-v1"},{"sourceId":"book-storage","anchor":"opw1"},{"sourceId":"book-storage","anchor":"mario-book1-v1"}]},
    {"id":"R12","scope":["bomb","platform"],"statement":"炸弹每关五个不同目标；游戏进度独立；链接、按钮、表单或其他可聚焦控件获得焦点时保留 Enter/Space 原生行为。","evidence":[{"sourceId":"policy","anchor":"Preserve native Enter/Space behavior"},{"sourceId":"bomb-entry","anchor":"mario-bomb-game-progress-v1"},{"sourceId":"bomb-entry","anchor":"BOMB_MOONS_PER_LEVEL = 5"}]},
    {"id":"R13","scope":["global"],"statement":"八学习页导航顺序为拼音/汉字/单词/Book1/主题/情景/总复习/音标；总复习与情景都是独立顶层模块；炸弹、贪吃蛇为独立游戏，共十页。","evidence":[{"sourceId":"policy","anchor":"Pinyin, Hanzi, Words, Book1, Theme Learning, Scenario Learning, Overall Review, Phonetics"},{"sourceId":"shell","anchor":"\"bomb-game.html\", \"snake-game.html\""}]},
    {"id":"R14","scope":["global"],"statement":"Git 不同步浏览器 localStorage 进度；仓库内容数量不是个人已学数。没有明确学习者、设备/origin、时间与数据来源时不能生成真实进度报告。","evidence":[{"sourceId":"policy","anchor":"Browser progress is local to each browser profile and is not synchronized by Git."},{"sourceId":"server","anchor":"class LearningAppHandler"}]},
    {"id":"R15","scope":["scenario","theme"],"statement":"新情景在对话中创作，默认不增加网页生成表单/API；用户明确请求时可以重新设计。中间图 output/，批准资源 assets/，保留私有旧草稿。","evidence":[{"sourceId":"policy","anchor":"unless explicitly requested"},{"sourceId":"policy","anchor":"assets/scenarios/"},{"sourceId":"scenario-words","anchor":"Authoring and imagegen happen in the conversation"}]},
    {"id":"R16","scope":["global"],"statement":"每次交付递增 APP_VERSION 和包版本，十页 version-update.js 查询版本一致；被引用 JS/CSS 改动联动缓存及匹配测试。","evidence":[{"sourceId":"policy","anchor":"all ten page references"},{"sourceId":"constants","anchor":"export const APP_VERSION"}]},
    {"id":"R17","scope":["global"],"statement":"交付跑 check/test/diff-check；界面改动在真实 Edge 桌面和 390px 做相关验收，准确报告模拟与硬件验证范围；保护既有改动及服务，按长期授权提交推送。","evidence":[{"sourceId":"policy","anchor":"Minimum completion gate"},{"sourceId":"policy","anchor":"standing authorization to commit and push"}]},
    {"id":"R18","scope":["hanzi","words","pinyin","phonetics"],"statement":"汉字引擎被单词直接复用，音标继承汉字，拼音继承音标；共享实现修改须评估四模块影响，不能将独立存储误当实现隔离。","evidence":[{"sourceId":"ipa-engine","anchor":"extends HanziEngine"},{"sourceId":"pinyin-engine","anchor":"extends PhoneticsEngine"},{"sourceId":"words-entry","anchor":"import { HanziEngine }"}]},
    {"id":"R19","scope":["theme","words","review"],"statement":"显示文案和稳定 ID 区分：课堂显示 desk 保留内部 table/classroom:table；BE 缩写的显示大小写不改变规范化词 ID。","evidence":[{"sourceId":"theme-entry","anchor":"id: \"table\", word: \"desk\""},{"sourceId":"be-data","anchor":"displayWord"},{"sourceId":"word-library","anchor":"normalizeLibraryWord"}]},
    {"id":"R20","scope":["global"],"statement":"目前只有静态网站与手柄相关 API；企业微信、DeepSeek 调度、可执行技能注册、学习进度上传和作业下发均待实现。分析记录不是执行结果或运行时权限校验。","evidence":[{"sourceId":"server","anchor":"def do_POST(self):"},{"sourceId":"server","anchor":"if urlsplit(self.path).path != \"/api/controller-mouse\""}]},
    {"id":"R21","scope":["snake","platform"],"statement":"贪吃蛇只写独立游戏key，汉字/旧汉字只读；100字池、每批5字自动接续、奇偶双向题及同音排除。认字得星星，病毒攒成长；危险碰撞和找错掉尾。吸取限小中病毒，保持同向可加速，定时中毒持续掉尾，解毒消耗星星；范围/比例/中毒参数及动作快捷键可配置并保存。六边形选项、全屏隐藏菜单仅显示放大目标。刷新暂停续玩；演示不覆盖正式进度，保留原生键盘及单宿主手柄互斥，不改炸弹规则。","evidence":[{"sourceId":"snake-learning","anchor":"RUN_SIZE = 100"},{"sourceId":"snake-learning","anchor":"BATCH_SIZE = 5"},{"sourceId":"snake-learning","anchor":"mario-snake-game-progress-v1"},{"sourceId":"snake-entry","anchor":"if (result.complete) learning.nextBatch()"},{"sourceId":"snake-actions","anchor":"export class PoisonState"},{"sourceId":"snake-bindings","anchor":"export function bindingError"},{"sourceId":"snake-entry","anchor":"mode === \"auto\" || window.STUDY_FULLSCREEN_SHELL?.isHosting()"},{"sourceId":"snake-entry","anchor":"if (demoCheckpoint) restore(demoCheckpoint)"}]}
